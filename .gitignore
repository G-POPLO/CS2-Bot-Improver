**/bin/
**/obj/
.gitignore

# Visual Studio / MSBuild caches
.vs/
*.user
*.suo

# Prebuilt assemblies staged by inno-setup/tools/assemble-payload.mjs so that
# projects referencing <HintPath>libs/…</HintPath> can compile.
addons/**/libs/

# Panel tooling
Panel/node_modules/
Panel/dist/

# Inno Setup compiler output
inno-setup/output/
# The distribution tree the installer packages: downloaded, not source.
inno-setup/payload/
# Per-machine record of what --deploy last wrote into a game install, so a later
# deploy can withdraw a plugin this repository no longer contains. Machine-local
# by nature: it names a game folder on this disk.
inno-setup/.deploy-state.json
