{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panel",
  "version": "1.4.5",
  "identifier": "com.cs2botimprover.panel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CS2 Bot Improver",
        "width": 575,
        "height": 900,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "center": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "CS2-Bot-Improver",
    "category": "Utility",
    "shortDescription": "CS2 Bot Improver Panel",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
